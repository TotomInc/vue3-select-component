{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "minimumReleaseAge": "24 hours",
  "updateNotScheduled": false,
  "internalChecksFilter": "strict",
  "groupName": "all dependencies",
  "groupSlug": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-3 * * 1"
    ]
  },
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all",
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "ignoreDeps": [
    "eslint",
    "pnpm",
    "typescript"
  ],
  "separateMajorMinor": false
}
